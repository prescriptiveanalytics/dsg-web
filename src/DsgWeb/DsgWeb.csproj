<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <Authors>Pascal Pomper</Authors>
        <Title>DsgWeb</Title>
        <Copyright>Copyright (c) Heuristic and Evolutionary Algorithms Laboratory (HEAL) 2026.</Copyright>
        <PackageProjectUrl>https://github.com/prescriptiveanalytics/dsg-web</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/prescriptiveanalytics/dsg-web.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <OpenApiDocumentsDirectory>$(BaseIntermediateOutputPath)</OpenApiDocumentsDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DataStreamGenerator" Version="1.0.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
