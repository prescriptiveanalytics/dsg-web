<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <RootNamespace>DsgWeb.Client</RootNamespace>
    </PropertyGroup>

    <!-- NuGet package -->
    <PropertyGroup>
        <PackageId>DsgWeb.Client</PackageId>
        <Authors>Pascal Pomper</Authors>
        <Title>DsgWeb.Client</Title>
        <Description>Typed HTTP client for the DsgWeb REST API, which starts and stops MQTT data streams generated by the DataStreamGenerator.</Description>
        <Copyright>Copyright (c) Heuristic and Evolutionary Algorithms Laboratory (HEAL) 2026.</Copyright>
        <PackageTags>dsg;datastreamgenerator;mqtt;data-stream;client;openapi</PackageTags>
        <PackageProjectUrl>https://github.com/prescriptiveanalytics/dsg-web</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/prescriptiveanalytics/dsg-web.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- The client code is generated into obj/, so embed it for Source Link. -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DataStreamGenerator" Version="1.0.0" />
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NSwag.ApiDescription.Client" Version="14.7.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Build DsgWeb first so its OpenAPI document exists; it is not a dependency of the package. -->
    <ItemGroup>
        <ProjectReference Include="..\DsgWeb\DsgWeb.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <!-- The DSG configuration types are reused from the DataStreamGenerator package instead of being generated. -->
    <ItemGroup>
        <OpenApiReference Include="..\DsgWeb\obj\DsgWeb.json" CodeGenerator="NSwagCSharp" ClassName="DsgWebClient" Namespace="DsgWeb.Client">
            <Options>/JsonLibrary:SystemTextJson /UseBaseUrl:false /GenerateClientInterfaces:true /GenerateNullableReferenceTypes:true /GenerateOptionalPropertiesAsNullable:true /AdditionalNamespaceUsages:DSG.DataStreamGenerator.Configuration /ExcludedTypeNames:GeneratorConfig,DriverConfig,SeriesConfig,SeriesConfigBase,SeriesConfigARSeriesConfig,SeriesConfigARMASeriesConfig,SeriesConfigARIMASeriesConfig,SeriesConfigMESeriesConfig,SeriesConfigMECSeriesConfig,SeriesConfigMEMCSeriesConfig,SeriesConfigXFSeriesConfig,SeriesConfigXGSeriesConfig,SeriesConfigIntSeqSeriesConfig</Options>
        </OpenApiReference>
    </ItemGroup>

</Project>
